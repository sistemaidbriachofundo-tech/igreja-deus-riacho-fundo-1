# Copiar para .env.hml (não versionar). Dados fictícios apenas.
# NÃO usar JWT_SECRET com prefixo dev-only- em HML.

POSTGRES_USER=idbrf
POSTGRES_PASSWORD=change-me-hml-strong-password
POSTGRES_DB=idbrf

DATABASE_URL=postgresql://idbrf:change-me-hml-strong-password@localhost:5432/idbrf?schema=public

NODE_ENV=production
API_PORT=3001
JWT_SECRET=replace-with-at-least-32-char-secret!!
JWT_EXPIRES_SECONDS=3600
CORS_ORIGIN=https://fe-hml.example.org
STORAGE_ROOT=/var/lib/idbrf/private-storage
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Após provisionar + TLS: documentar a URL real em docs/hml-runbook.md
# NEXT_PUBLIC_API_URL=https://api-hml.example.org
