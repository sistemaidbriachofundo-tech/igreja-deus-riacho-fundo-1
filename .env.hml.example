# Copiar para .env.hml (não versionar). Dados fictícios apenas.
# NÃO usar JWT_SECRET com prefixo dev-only- em HML.
# Checklist: deploy/hml/secrets-checklist.md · Runbook: docs/hml-hostinger-runbook.md

POSTGRES_USER=idbrf
POSTGRES_PASSWORD=change-me-hml-strong-password
POSTGRES_DB=idbrf

DATABASE_URL=postgresql://idbrf:change-me-hml-strong-password@localhost:5432/idbrf?schema=public

NODE_ENV=production
API_PORT=3001
JWT_SECRET=replace-with-at-least-32-char-secret!!
JWT_EXPIRES_SECONDS=3600
CORS_ORIGIN=https://fe-hml.example.org
STORAGE_ROOT=/var/lib/idbrf/private-storage
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Migrate: sempre no boot (Dockerfile.api). Seed fictício só se =1 (primeiro boot).
SEED_ON_BOOT=0

# Após DNS + TLS: URL pública HTTPS (ecoada em GET /meta). Até lá: TBD.
# HML_PUBLIC_API_URL=https://api-hml.example.org
# NEXT_PUBLIC_API_URL=https://api-hml.example.org

# MFA (TOTP local) — chave dedicada em HML
# MFA_ENCRYPTION_KEY=replace-with-dedicated-mfa-key-32chars!

# OIDC — placeholders; NÃO ativar login federado sem PEN/F0
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_SECRET_REF=OIDC_CLIENT_SECRET
# OIDC_REDIRECT_URI=https://api-hml.example.org/auth/oidc/callback
# OIDC_SCOPES=openid profile email
