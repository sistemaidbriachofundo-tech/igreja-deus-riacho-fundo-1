{
  "name": "igreja-deus-riacho-fundo-1",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestão eclesiástica — Igreja de Deus Riacho Fundo I (piloto)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @idbrf/shared && npm run build -w @idbrf/db && npm run build -w @idbrf/api && npm run build -w @idbrf/web",
    "dev:api": "npm run start:dev -w @idbrf/api",
    "dev:web": "npm run dev -w @idbrf/web",
    "db:generate": "npm run generate -w @idbrf/db",
    "db:migrate": "npm run migrate:dev -w @idbrf/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @idbrf/db",
    "db:seed": "npm run seed -w @idbrf/db",
    "homolog:m1": "node scripts/homolog-m1-admission.mjs",
    "homolog:backup": "bash scripts/pg-backup-restore-smoke.sh",
    "test:pg": "RUN_PG_INTEGRATION=1 npm run test -w @idbrf/db -- --test-name-pattern=postgres",
    "homolog:readiness": "node scripts/backend-readiness-smoke.mjs",
    "homolog:fase1": "node scripts/hml/fase1-e2e.mjs",
    "homolog:eklesia": "node scripts/hml/eklesia-release-gate.mjs",
    "homolog:revitalizacao": "node --import tsx scripts/hml/release-inventory.mjs && node --import tsx scripts/hml/release-revitalization-gate.mjs",
    "hml:migrate": "node --import tsx scripts/hml/release-migrate-guard.mjs",
    "test": "npm run test --workspaces --if-present && node --test scripts/hml/hml-guard.test.mjs scripts/hml/presentation/seed-hml.test.mjs",
    "release:preflight": "node scripts/release/production-preflight.mjs",
    "release:f11-preflight": "node scripts/release/f11-preflight.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.9",
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "@vercel/cli-config": {
      "zod": "4.6.6"
    }
  }
}
