# Copie para .env e ajuste. Nunca commit .env com valores reais.

# Postgres (docker compose local — opção A)
POSTGRES_USER=idbrf
POSTGRES_PASSWORD=idbrf_dev_only
POSTGRES_DB=idbrf
POSTGRES_PORT=5432
DATABASE_URL=postgresql://idbrf:idbrf_dev_only@localhost:5432/idbrf?schema=public

# API NestJS
API_PORT=3001
NODE_ENV=development
# HML/PRD: CSV de origens FE (obrigatório se NODE_ENV=production)
# CORS_ORIGIN=https://fe-hml.example.org
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Storage privado de documentos de admissão (fora de web pública)
STORAGE_ROOT=.data/private-storage
# —— HML ops (Hostinger) — preencher só com autorização + DNS/TLS ——
# Hostname API no VPS (render proxy / smoke)
# HML_API_HOSTNAME=api-hml.example.org
# URL pública HTTPS (ecoada em GET /meta) — TBD até TLS
# HML_PUBLIC_API_URL=https://api-hml.example.org
# Alvo dos scripts/smoke-hml.sh e scripts/smoke-vivi.sh
# HML_BASE_URL=http://127.0.0.1:3001
# HML_SMOKE_EMAIL=ana.demo@example.test
# HML_SMOKE_PASSWORD=admin
# HML_SMOKE_SKIP_AUTH=0
# HML_EXPECT_CONTRACT=0.7.1-vivi
# VIVI_SMOKE_REQUIRE_LIVE=0
# Seed fictício no primeiro boot da imagem API (Dockerfile.api)
# SEED_ON_BOOT=0

# IAM / JWT (F1 — trocar em HML/PRD)
# Produção: ≥ 32 chars e sem prefixo "dev-only-". Senhas novas/seed: Argon2id.
JWT_SECRET=dev-only-jwt-secret-change-me-32chars!
JWT_EXPIRES_SECONDS=3600

# MFA TOTP (local — sem IdP). Chave AES para cifrar secrets no banco.
# Em DEV pode omitir (deriva de JWT_SECRET). Em HML/PRD: ≥ 32 chars dedicados.
# MFA_ENCRYPTION_KEY=replace-with-dedicated-mfa-key-32chars!

# OIDC (hooks/config only — IdP live NÃO ativo neste contrato; F0/PEN)
# Preencher quando houver issuer institucional autorizado:
# OIDC_ISSUER_URL=https://login.example.org
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_SECRET_REF=OIDC_CLIENT_SECRET
# OIDC_REDIRECT_URI=http://localhost:3001/auth/oidc/callback
# OIDC_SCOPES=openid profile email

# Web Next.js (dev). Em Pages o build é estático (sem API).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BASE_PATH=

# Redis (compose; uso futuro)
REDIS_URL=redis://localhost:6379

# —— F5 Canais (sem WABA/SMTP/FCM live nesta fatia) ——
# Providers: mock (simula entrega) | noop (aceita sem enviar)
CHANNELS_PROVIDER=noop
WHATSAPP_PROVIDER=noop
EMAIL_PROVIDER=noop
PUSH_PROVIDER=noop
# Rate limits por canal (in-memory, single-node)
CHANNELS_WHATSAPP_RATE_MAX=20
CHANNELS_WHATSAPP_RATE_WINDOW_MS=60000
CHANNELS_EMAIL_RATE_MAX=60
CHANNELS_EMAIL_RATE_WINDOW_MS=60000
CHANNELS_PUSH_RATE_MAX=120
CHANNELS_PUSH_RATE_WINDOW_MS=60000
# Chaves live documentadas — NÃO usadas até aprovação WABA/SMTP/FCM:
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# FCM_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=

# —— Vivi (assistente IA) — chaves SÓ no backend; nunca no FE/Git / NEXT_PUBLIC_* ——
# Provider: manus | gemini | mock
# Default automático: manus se MANUS_FORGE_URL+MANUS_API_KEY; senão gemini se GEMINI_API_KEY; senão mock
# Em NODE_ENV=production: VIVI_PROVIDER=manus|gemini SEM key → boot FALHA (mensagem clara).
# DEV: fallback mock com aviso em GET /vivi/status (credentialsReady=false, configWarnings[]).
# VIVI_PROVIDER=manus
#
# Manus Forge (preferido em HML) — gateway Manus; sem chave Google no código
# Nomes canônicos IDBRF + aliases da plataforma Manus (BUILT_IN_FORGE_*):
# MANUS_FORGE_URL=https://forge.manus.im
# MANUS_API_KEY=
# BUILT_IN_FORGE_API_URL=   # alias opcional
# BUILT_IN_FORGE_API_KEY=   # alias opcional
# MANUS_MODEL=auto
#
# Google AI Studio (opcional) — GEMINI_API_KEY nunca no frontend
# GEMINI_API_KEY=
# Modelo default: gemini-2.5-flash-lite (Flash “cheio”/2.0 podem depreciar — ver handoff)
# GEMINI_MODEL=gemini-2.5-flash-lite
#
# Rate limits (in-memory, single-node)
VIVI_PUBLIC_RATE_MAX=8
VIVI_PUBLIC_RATE_WINDOW_MS=60000
VIVI_ADMIN_RATE_MAX=60
VIVI_ADMIN_RATE_WINDOW_MS=60000
# Auditoria de uso (contagem/metadados; sem prompt completo) — 0|false|off desliga
VIVI_AUDIT=1
# Go-live: docs/go-live-hml-vivi.md · smokes: scripts/smoke-hml.sh · scripts/smoke-vivi.sh
