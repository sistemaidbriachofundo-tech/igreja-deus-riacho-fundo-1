# Nginx reverse proxy — API HML (TLS termination)
# Placeholder: __HML_API_HOSTNAME__ (render via scripts/hml/render-proxy-templates.sh)
# Do NOT commit real secrets. Upstream: docker-compose.hml binds API to 127.0.0.1:3001.
#
# Install (on VPS, after TLS cert exists):
#   export HML_API_HOSTNAME=api-hml.example.org
#   ./scripts/hml/render-proxy-templates.sh
#   sudo cp deploy/hml/rendered/nginx/idbrf-api-hml.conf /etc/nginx/sites-available/
#   sudo ln -sf /etc/nginx/sites-available/idbrf-api-hml.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream idbrf_api_hml {
    server 127.0.0.1:3001;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name __HML_API_HOSTNAME__;

    # ACME HTTP-01 (certbot / Hostinger panel equivalent)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __HML_API_HOSTNAME__;

    # Paths after certbot / Hostinger SSL — adjust if panel uses different layout
    ssl_certificate     /etc/letsencrypt/live/__HML_API_HOSTNAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HML_API_HOSTNAME__/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # HML hardening
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    server_tokens off;
    client_max_body_size 6m;

    location / {
        proxy_pass http://idbrf_api_hml;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Never expose private admission storage via proxy
    location ^~ /var/lib/idbrf/ {
        deny all;
        return 404;
    }
}
