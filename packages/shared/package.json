{
  "name": "@idbrf/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos e utilitários compartilhados",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --import tsx --test src/index.test.ts src/person-id.test.ts src/rbac.test.ts src/credential-token.test.ts src/membership-scope.test.ts src/api-contracts/api-contracts.test.ts src/admission-rules.test.ts src/finance/ledger-rules.test.ts",
    "test:coverage": "c8 --reporter=lcov --reporter=text-summary --reports-dir=coverage --include='src/**/*.ts' --exclude='src/**/*.test.ts' npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "c8": "^10.1.3",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
