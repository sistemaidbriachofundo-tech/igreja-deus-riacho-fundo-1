enum SmallGroupMemberRole {
  LEADER
  MEMBER
}

model SmallGroupMember {
  id        String               @id @default(cuid())
  groupId   String               @map("group_id")
  personId  String               @map("person_id")
  role      SmallGroupMemberRole @default(MEMBER)
  joinedAt  DateTime             @default(now()) @map("joined_at")

  group  SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person Person     @relation(fields: [personId], references: [id])

  @@unique([groupId, personId])
  @@index([personId])
  @@map("small_group_members")
}

model GroupMeeting {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  occurredAt DateTime @map("occurred_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  group       SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances GroupMeetingAttendance[]

  @@index([groupId, occurredAt])
  @@map("group_meetings")
}

model GroupMeetingAttendance {
  id        String  @id @default(cuid())
  meetingId String  @map("meeting_id")
  personId  String  @map("person_id")
  present   Boolean @default(true)

  meeting GroupMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, personId])
  @@index([personId])
  @@map("group_meeting_attendances")
}

enum RosterStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RosterAssignmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  SUBSTITUTED
}

model Roster {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  churchId       String       @map("church_id")
  ministryId     String?      @map("ministry_id")
  title          String
  serviceAt      DateTime     @map("service_at")
  status         RosterStatus @default(DRAFT)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  ministry     Ministry?    @relation(fields: [ministryId], references: [id])
  slots        RosterSlot[]

  @@index([churchId, serviceAt])
  @@index([ministryId])
  @@map("rosters")
}

model RosterSlot {
  id            String  @id @default(cuid())
  rosterId      String  @map("roster_id")
  roleLabel     String  @map("role_label")
  requiresCouple Boolean @default(false) @map("requires_couple")
  sortOrder     Int     @default(0) @map("sort_order")

  roster       Roster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  assignments  RosterAssignment[]

  @@index([rosterId])
  @@map("roster_slots")
}

model RosterAssignment {
  id                      String                 @id @default(cuid())
  slotId                  String                 @map("slot_id")
  personId                String                 @map("person_id")
  partnerPersonId         String?                @map("partner_person_id")
  status                  RosterAssignmentStatus @default(PENDING)
  substituteForId         String?                @map("substitute_for_id")
  confirmedAt             DateTime?              @map("confirmed_at")
  declinedAt              DateTime?              @map("declined_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  slot          RosterSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  person        Person     @relation("RosterAssignee", fields: [personId], references: [id])
  partner       Person?    @relation("RosterPartner", fields: [partnerPersonId], references: [id])
  substituteFor RosterAssignment?  @relation("RosterSubstitution", fields: [substituteForId], references: [id])
  substitutes   RosterAssignment[] @relation("RosterSubstitution")

  @@index([slotId, status])
  @@index([personId])
  @@map("roster_assignments")
}

/// RF-014 — janela recorrente de disponibilidade (UTC weekday + minutos do dia).
model VolunteerAvailability {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  churchId       String   @map("church_id")
  personId       String   @map("person_id")
  /// 0=Domingo … 6=Sábado (getUTCDay)
  weekday        Int
  /// Minutos desde 00:00 UTC inclusivo
  startMinute    Int      @map("start_minute")
  /// Minutos desde 00:00 UTC exclusivo
  endMinute      Int      @map("end_minute")
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])

  @@index([churchId, personId, active])
  @@index([personId])
  @@map("volunteer_availabilities")
}

/// RF-014 — impedimento pontual (bloqueia escala no intervalo).
model VolunteerImpediment {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  churchId        String   @map("church_id")
  personId        String   @map("person_id")
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  reason          String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])

  @@index([churchId, personId, startsAt, endsAt])
  @@index([personId])
  @@map("volunteer_impediments")
}

enum CoupleExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// RF-014 — exceção configurável à regra requiresCouple (simulação + aprovação).
model RosterCoupleException {
  id                String                @id @default(cuid())
  organizationId    String                @map("organization_id")
  churchId          String                @map("church_id")
  ministryId        String?               @map("ministry_id")
  rosterId          String?               @map("roster_id")
  slotId            String?               @map("slot_id")
  personId          String                @map("person_id")
  reason            String
  status            CoupleExceptionStatus @default(PENDING)
  /// true = criada via simulate (aguarda aprovação); false = configurada direto
  simulation        Boolean               @default(true)
  requestedByUserId String                @map("requested_by_user_id")
  reviewedByUserId  String?               @map("reviewed_by_user_id")
  reviewedAt        DateTime?             @map("reviewed_at")
  notes             String?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])

  @@index([churchId, personId, status])
  @@index([slotId, status])
  @@index([rosterId, status])
  @@map("roster_couple_exceptions")
}

// —— F1/F2 hooks: MFA (TOTP) + OIDC config (sem IdP live) ——

enum MfaFactorType {
  TOTP
}

enum MfaFactorStatus {
  DISABLED
  PENDING_ENROLLMENT
  ENABLED
}

enum OidcProviderStatus {
  DISABLED
  CONFIGURED
  ENABLED
}

/// Fator MFA por usuário — TOTP local; secret cifrado; sem IdP.
model UserMfaFactor {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  factorType       MfaFactorType   @default(TOTP) @map("factor_type")
  status           MfaFactorStatus @default(DISABLED)
  /// Segredo TOTP cifrado (AES-GCM); nunca expor em listagens.
  secretCiphertext String?         @map("secret_ciphertext")
  label            String?
  verifiedAt       DateTime?       @map("verified_at")
  disabledAt       DateTime?       @map("disabled_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, factorType])
  @@index([userId, status])
  @@map("user_mfa_factors")
}

// —— F1.1: sessão revogável, desafio MFA de uso único, política e limite compartilhado.
// Migração aditiva. Não reescreve audit_logs existentes. Não aplicar em banco remoto
// sem autorização explícita do responsável.

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MfaChallengePurpose {
  LOGIN
  REFRESH
  SWITCH_CHURCH
  STEP_UP
}

enum MfaChallengeStatus {
  PENDING
  CONSUMED
  EXPIRED
  REVOKED
}

enum MfaEnforcementMode {
  OFF
  PRIVILEGED
  ALL
}

/// Sessão de refresh. O token opaco não é persistido; só o hash.
model AuthSession {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  familyId         String            @map("family_id")
  status           AuthSessionStatus @default(ACTIVE)
  authzVersion     Int               @map("authz_version")
  policyVersion    Int               @map("policy_version")
  refreshTokenHash String            @unique @map("refresh_token_hash")
  /// Fingerprint da frente A. O sid em claro não é gravado.
  authzFingerprint String?           @map("authz_fingerprint")
  mfaSatisfied     Boolean           @default(false) @map("mfa_satisfied")
  issuedAt         DateTime          @default(now()) @map("issued_at")
  expiresAt        DateTime          @map("expires_at")
  revokedAt        DateTime?         @map("revoked_at")
  revokeReason     String?           @map("revoke_reason")
  replacedById     String?           @unique @map("replaced_by_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Desafio opaco de curta duração. Uso único por atualização condicional.
model MfaChallenge {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  purpose      MfaChallengePurpose
  status       MfaChallengeStatus  @default(PENDING)
  tokenHash     String              @unique @map("token_hash")
  /// totp ou enroll. O enum purpose guarda LOGIN ou STEP_UP.
  challengeKind String?            @map("challenge_kind")
  expiresAt     DateTime            @map("expires_at")
  consumedAt    DateTime?           @map("consumed_at")
  attemptCount  Int                 @default(0) @map("attempt_count")
  maxAttempts   Int                 @default(5) @map("max_attempts")
  reads         Int                 @default(0)
  createdAt    DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

/// Versão de política por plataforma (scopeKey=platform) ou por organização.
model SecurityPolicy {
  id                  String             @id @default(cuid())
  scopeKey            String             @unique @map("scope_key")
  organizationId      String?            @map("organization_id")
  version             Int                @default(1)
  mfaEnforcement      MfaEnforcementMode @default(PRIVILEGED) @map("mfa_enforcement")
  privilegedRoleCodes String[]           @default([]) @map("privileged_role_codes")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("security_policies")
}

/// Contador compartilhado entre instâncias. A chave é hash; o IP bruto não fica gravado.
model RateLimitBucket {
  id          String   @id @default(cuid())
  keyHash     String   @map("key_hash")
  windowStart DateTime @map("window_start")
  hits        Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([keyHash, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

/// Falhas de senha e de MFA compartilhadas entre instâncias. A chave já é fingerprint.
model AuthAttemptWindow {
  bucketKey       String   @id @map("bucket_key")
  failures        Int
  windowStartedAt DateTime @map("window_started_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("auth_attempt_windows")
}

/// Config OIDC por organização — placeholders; login federado NÃO live neste contrato.
model OidcProviderConfig {
  id              String             @id @default(cuid())
  organizationId  String             @map("organization_id")
  status          OidcProviderStatus @default(DISABLED)
  displayName     String?            @map("display_name")
  issuerUrl       String?            @map("issuer_url")
  clientId        String?            @map("client_id")
  /// Nome da env/secret store — nunca o secret em claro no banco.
  clientSecretRef String?            @map("client_secret_ref")
  redirectUri     String?            @map("redirect_uri")
  scopes          String             @default("openid profile email")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId])
  @@map("oidc_provider_configs")
}

// —— F4 financeiro (núcleo ledger) — dados sintéticos apenas ——

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerEntryStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVERSED
}

enum LedgerLineSide {
  DEBIT
  CREDIT
}

enum BankImportFormat {
  CSV
  OFX
  PDF_META
}

enum BankImportStatus {
  RECEIVED
  /// CSV/OFX com linhas válidas parseadas.
  PARSED
  /// Legado / CSV vazio sem conteúdo — manter compat seed.
  PARSED_STUB
  /// PDF_META: só metadados; sem linhas de extrato (limitação honesta).
  META_ONLY
  FAILED
}

enum BankImportAdapter {
  FILE
  MOCK
  SICOOB
  BRB
  CORA
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum BankLineMatchStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  IGNORED
}

enum ReconciliationStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
  CLOSED
}

/// Centro de custo first-class (RF-016) — string legado `LedgerAccount.costCenter` permanece.
model CostCenter {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  churchId       String   @map("church_id")
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  accounts     LedgerAccount[]
  entries      LedgerEntry[]
  budgetLines  BudgetLine[]

  @@unique([churchId, code])
  @@index([organizationId, churchId])
  @@map("cost_centers")
}

/// Fundo / caixa restrito (ex.: missões, construção) — RF-016.
model Fund {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  churchId       String   @map("church_id")
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  entries      LedgerEntry[]
  budgetLines  BudgetLine[]

  @@unique([churchId, code])
  @@index([organizationId, churchId])
  @@map("funds")
}

/// Plano de contas por congregação (church-scoped).
model LedgerAccount {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  churchId       String            @map("church_id")
  code           String
  name           String
  type           LedgerAccountType
  parentId       String?           @map("parent_id")
  /// Legado livre (compat F4); preferir `costCenterId`.
  costCenter     String?           @map("cost_center")
  costCenterId   String?           @map("cost_center_id")
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  church       Church            @relation(fields: [churchId], references: [id])
  parent       LedgerAccount?    @relation("LedgerAccountTree", fields: [parentId], references: [id])
  children     LedgerAccount[]   @relation("LedgerAccountTree")
  costCenterRef CostCenter?      @relation(fields: [costCenterId], references: [id])
  lines        LedgerEntryLine[]
  budgetLines  BudgetLine[]
  receivingAccount ChurchReceivingAccount?

  @@unique([churchId, code])
  @@index([organizationId, churchId])
  @@index([churchId, type, active])
  @@index([costCenterId])
  @@map("ledger_accounts")
}

/// Vínculo Pix de uma conta bancária que já existe no plano da igreja.
/// A chave não é senha e não entra em trilha de auditoria.
model ChurchReceivingAccount {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  churchId        String   @map("church_id")
  ledgerAccountId String   @unique @map("ledger_account_id")
  displayName     String   @map("display_name")
  pixKey          String   @map("pix_key")
  merchantCity    String   @default("Brasilia") @map("merchant_city")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id])
  church         Church             @relation(fields: [churchId], references: [id])
  ledgerAccount  LedgerAccount      @relation(fields: [ledgerAccountId], references: [id])
  lots           EventLot[]
  paymentIntents EventPaymentIntent[]

  @@index([organizationId, churchId, active])
  @@map("church_receiving_accounts")
}

/// Lançamento contábil (cabeçalho) — partidas dobradas via linhas.
model LedgerEntry {
  id                     String            @id @default(cuid())
  organizationId         String            @map("organization_id")
  churchId               String            @map("church_id")
  entryDate              DateTime          @map("entry_date") @db.Date
  description            String
  status                 LedgerEntryStatus @default(DRAFT)
  /// Soma dos débitos (deve igualar créditos) — centavos BRL sintéticos.
  amountCents            Int               @map("amount_cents")
  createdByUserId        String            @map("created_by_user_id")
  submittedAt            DateTime?         @map("submitted_at")
  firstApprovedByUserId  String?           @map("first_approved_by_user_id")
  firstApprovedAt        DateTime?         @map("first_approved_at")
  secondApprovedByUserId String?           @map("second_approved_by_user_id")
  secondApprovedAt       DateTime?         @map("second_approved_at")
  rejectedByUserId       String?           @map("rejected_by_user_id")
  rejectedAt             DateTime?         @map("rejected_at")
  rejectionReason        String?           @map("rejection_reason")
  reversalOfEntryId      String?           @unique @map("reversal_of_entry_id")
  importBatchId          String?           @map("import_batch_id")
  reconciliationId       String?           @map("reconciliation_id")
  fundId                 String?           @map("fund_id")
  costCenterId           String?           @map("cost_center_id")
  /// Competência contábil (ano/mês); default = entryDate.
  competenceYear         Int?              @map("competence_year")
  competenceMonth        Int?              @map("competence_month")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id])
  church        Church           @relation(fields: [churchId], references: [id])
  createdBy     User             @relation("LedgerEntryCreator", fields: [createdByUserId], references: [id])
  firstApprover User?            @relation("LedgerEntryFirstApprover", fields: [firstApprovedByUserId], references: [id])
  secondApprover User?           @relation("LedgerEntrySecondApprover", fields: [secondApprovedByUserId], references: [id])
  reversalOf    LedgerEntry?     @relation("LedgerEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversedBy    LedgerEntry?     @relation("LedgerEntryReversal")
  importBatch   BankImportBatch? @relation(fields: [importBatchId], references: [id])
  reconciliation Reconciliation? @relation(fields: [reconciliationId], references: [id])
  fund          Fund?            @relation(fields: [fundId], references: [id])
  costCenterRef CostCenter?      @relation(fields: [costCenterId], references: [id])
  lines         LedgerEntryLine[]
  matchedBankLines BankStatementLine[]
  attachments   LedgerEntryAttachment[]
  eventPayment  EventPaymentIntent?

  @@index([organizationId, churchId, status])
  @@index([churchId, entryDate])
  @@index([importBatchId])
  @@index([reconciliationId])
  @@index([fundId])
  @@index([costCenterId])
  @@index([churchId, competenceYear, competenceMonth])
  @@map("ledger_entries")
}

/// Comprovante/anexo de lançamento — bytes em STORAGE_ROOT privado (RF-016).
model LedgerEntryAttachment {
  id               String   @id @default(cuid())
  entryId          String   @map("entry_id")
  organizationId   String   @map("organization_id")
  churchId         String   @map("church_id")
  uploadedByUserId String   @map("uploaded_by_user_id")
  displayName      String   @map("display_name")
  contentType      String   @map("content_type")
  byteSize         Int      @map("byte_size")
  storageKey       String   @unique @map("storage_key")
  createdAt        DateTime @default(now()) @map("created_at")

  entry          LedgerEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  church         Church       @relation(fields: [churchId], references: [id])
  uploadedBy     User         @relation("LedgerAttachmentUploader", fields: [uploadedByUserId], references: [id])

  @@index([entryId])
  @@index([organizationId, churchId])
  @@map("ledger_entry_attachments")
}

model LedgerEntryLine {
  id          String         @id @default(cuid())
  entryId     String         @map("entry_id")
  accountId   String         @map("account_id")
  side        LedgerLineSide
  amountCents Int            @map("amount_cents")
  memo        String?

  entry   LedgerEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("ledger_entry_lines")
}

/// Importação CSV/OFX/PDF_META — OFX real; PDF_META = META_ONLY (sem linhas).
model BankImportBatch {
  id              String            @id @default(cuid())
  organizationId  String            @map("organization_id")
  churchId        String            @map("church_id")
  format          BankImportFormat
  status          BankImportStatus  @default(RECEIVED)
  /// Adapter de origem: FILE (padrão), MOCK, ou rótulos SICOOB/BRB/CORA sem API live.
  adapter         BankImportAdapter @default(FILE)
  filename        String
  stubNote        String?           @map("stub_note")
  lineCount       Int               @default(0) @map("line_count")
  createdByUserId String            @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  church       Church              @relation(fields: [churchId], references: [id])
  createdBy    User                @relation("BankImportCreator", fields: [createdByUserId], references: [id])
  lines        BankStatementLine[]
  ledgerEntries LedgerEntry[]

  @@index([organizationId, churchId, status])
  @@index([adapter])
  @@map("bank_import_batches")
}

model BankStatementLine {
  id             String              @id @default(cuid())
  batchId        String              @map("batch_id")
  postedAt       DateTime            @map("posted_at")
  amountCents    Int                 @map("amount_cents")
  description    String
  externalRef    String?             @map("external_ref")
  matchStatus    BankLineMatchStatus @default(UNMATCHED) @map("match_status")
  matchedEntryId String?             @map("matched_entry_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  batch        BankImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matchedEntry LedgerEntry?    @relation(fields: [matchedEntryId], references: [id])

  @@index([batchId, matchStatus])
  @@index([matchedEntryId])
  @@map("bank_statement_lines")
}

/// Conciliação periódica com stub de dupla aprovação.
model Reconciliation {
  id                     String               @id @default(cuid())
  organizationId         String               @map("organization_id")
  churchId               String               @map("church_id")
  title                  String
  periodStart            DateTime             @map("period_start") @db.Date
  periodEnd              DateTime             @map("period_end") @db.Date
  status                 ReconciliationStatus @default(OPEN)
  notes                  String?
  createdByUserId        String               @map("created_by_user_id")
  firstApprovedByUserId  String?              @map("first_approved_by_user_id")
  firstApprovedAt        DateTime?            @map("first_approved_at")
  secondApprovedByUserId String?              @map("second_approved_by_user_id")
  secondApprovedAt       DateTime?            @map("second_approved_at")
  closedAt               DateTime?            @map("closed_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id])
  church         Church        @relation(fields: [churchId], references: [id])
  createdBy      User          @relation("ReconciliationCreator", fields: [createdByUserId], references: [id])
  firstApprover  User?         @relation("ReconciliationFirstApprover", fields: [firstApprovedByUserId], references: [id])
  secondApprover User?         @relation("ReconciliationSecondApprover", fields: [secondApprovedByUserId], references: [id])
  entries        LedgerEntry[]

  @@index([organizationId, churchId, status])
  @@index([churchId, periodStart, periodEnd])
  @@map("reconciliations")
}

/// Orçamento anual mínimo (RF-019) — linhas planejadas por conta/fundo/CC.
model Budget {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  churchId        String       @map("church_id")
  year            Int
  title           String
  status          BudgetStatus @default(DRAFT)
  notes           String?
  createdByUserId String       @map("created_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  createdBy    User         @relation("BudgetCreator", fields: [createdByUserId], references: [id])
  lines        BudgetLine[]

  @@unique([churchId, year, title])
  @@index([organizationId, churchId, status])
  @@map("budgets")
}

model BudgetLine {
  id            String   @id @default(cuid())
  budgetId      String   @map("budget_id")
  accountId     String   @map("account_id")
  fundId        String?  @map("fund_id")
  costCenterId  String?  @map("cost_center_id")
  plannedCents  Int      @map("planned_cents")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  budget     Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account    LedgerAccount @relation(fields: [accountId], references: [id])
  fund       Fund?       @relation(fields: [fundId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  @@index([budgetId])
  @@index([accountId])
  @@map("budget_lines")
}

/// Competência / fechamento mínimo mensal (RF-019) — bloqueia novos lançamentos no mês CLOSED.
model AccountingPeriod {
  id              String                 @id @default(cuid())
  organizationId  String                 @map("organization_id")
  churchId        String                 @map("church_id")
  year            Int
  month           Int
  status          AccountingPeriodStatus @default(OPEN)
  closedAt        DateTime?              @map("closed_at")
  closedByUserId  String?                @map("closed_by_user_id")
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  closedBy     User?        @relation("AccountingPeriodCloser", fields: [closedByUserId], references: [id])

  @@unique([churchId, year, month])
  @@index([organizationId, churchId, status])
  @@map("accounting_periods")
}

// —— F5 Canais (sem WABA/SMTP/FCM live; providers mock/noop) ——

enum CommChannel {
  WHATSAPP
  EMAIL
  PUSH
}

/// Plataforma do device token (RF-025 — registro só; FCM live ausente).
enum PushPlatform {
  ANDROID
  IOS
  WEB
}

enum OutboxStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  DEAD
  CANCELLED
}

/// Template de mensagem por canal (placeholders {{var}}).
model MessageTemplate {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  churchId       String      @map("church_id")
  channel        CommChannel
  code           String
  name           String
  subject        String?
  body           String
  locale         String      @default("pt-BR")
  /// Nome do template Meta (só documentado; sem WABA live).
  providerTemplateName String? @map("provider_template_name")
  variables      Json?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  outbox       CommunicationOutbox[]

  @@unique([churchId, channel, code])
  @@index([organizationId, churchId])
  @@map("message_templates")
}

/// Consentimento LGPD por pessoa/canal (opt-in explícito).
model CommunicationConsent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  churchId       String   @map("church_id")
  personId       String   @map("person_id")
  whatsappOptIn  Boolean  @default(false) @map("whatsapp_opt_in")
  emailOptIn     Boolean  @default(false) @map("email_opt_in")
  pushOptIn      Boolean  @default(false) @map("push_opt_in")
  /// Finalidades: TRANSACTIONAL | CMS_PUBLISH | PASTORAL_NOTICE (JSON array).
  purposes       Json     @default("[]")
  source         String?
  recordedAt     DateTime @default(now()) @map("recorded_at")
  revokedAt      DateTime? @map("revoked_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])

  @@unique([churchId, personId])
  @@index([organizationId, churchId])
  @@index([personId])
  @@map("communication_consents")
}

/// Outbox de comunicação — fila durável antes do provider.
model CommunicationOutbox {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  churchId         String       @map("church_id")
  channel          CommChannel
  status           OutboxStatus @default(PENDING)
  personId         String?      @map("person_id")
  /// Destino: E.164 / e-mail / device token (mock).
  toAddress        String       @map("to_address")
  templateId       String?      @map("template_id")
  templateCode     String?      @map("template_code")
  subject          String?
  bodyRendered     String       @map("body_rendered")
  payload          Json?
  consentCheckedAt DateTime?    @map("consent_checked_at")
  providerMessageId String?     @map("provider_message_id")
  lastError        String?      @map("last_error")
  attemptCount     Int          @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?    @map("next_attempt_at")
  scheduledAt      DateTime?    @map("scheduled_at")
  sentAt           DateTime?    @map("sent_at")
  deliveredAt      DateTime?    @map("delivered_at")
  /// Ex.: cms_content | manual | system
  sourceType       String?      @map("source_type")
  sourceId         String?      @map("source_id")
  createdByUserId  String?      @map("created_by_user_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  person       Person?      @relation(fields: [personId], references: [id])
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  deliveryEvents OutboxDeliveryEvent[]

  @@index([organizationId, churchId, status])
  @@index([channel, status, nextAttemptAt])
  @@index([personId])
  @@index([sourceType, sourceId])
  @@map("communication_outbox")
}

model OutboxDeliveryEvent {
  id               String       @id @default(cuid())
  outboxId         String       @map("outbox_id")
  status           OutboxStatus
  providerResponse Json?        @map("provider_response")
  errorMessage     String?      @map("error_message")
  createdAt        DateTime     @default(now()) @map("created_at")

  outbox CommunicationOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId, createdAt])
  @@map("outbox_delivery_events")
}

/// Política de retenção pastoral (RF-009) — por congregação.
model PastoralRetentionPolicy {
  id                       String   @id @default(cuid())
  organizationId           String   @map("organization_id")
  churchId                 String   @map("church_id")
  /// Dias após closedAt para casos DONE/CANCELLED elegíveis a minimização.
  closedCaseRetentionDays  Int      @default(2555) @map("closed_case_retention_days")
  /// Quando true, apply redige summary (não apaga o caso).
  redactionEnabled         Boolean  @default(true) @map("redaction_enabled")
  updatedByUserId          String?  @map("updated_by_user_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  updatedBy    User?        @relation("PastoralRetentionUpdater", fields: [updatedByUserId], references: [id])

  @@unique([churchId])
  @@index([organizationId])
  @@map("pastoral_retention_policies")
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum CourseClassStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum CourseEnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
  CANCELLED
}

/// Curso / EBD (RF-023) — domínio distinto de discipulado (RF-010).
model Course {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  churchId       String       @map("church_id")
  code           String?
  name           String
  description    String?
  status         CourseStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  church       Church        @relation(fields: [churchId], references: [id])
  classes      CourseClass[]

  @@unique([churchId, code])
  @@index([organizationId, churchId])
  @@map("courses")
}

/// Turma de um curso/EBD.
model CourseClass {
  id              String            @id @default(cuid())
  courseId        String            @map("course_id")
  organizationId  String            @map("organization_id")
  churchId        String            @map("church_id")
  name            String
  teacherPersonId String?           @map("teacher_person_id")
  startsAt        DateTime?         @map("starts_at")
  endsAt          DateTime?         @map("ends_at")
  status          CourseClassStatus @default(OPEN)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  organization  Organization        @relation(fields: [organizationId], references: [id])
  church        Church              @relation(fields: [churchId], references: [id])
  teacher       Person?             @relation("CourseClassTeacher", fields: [teacherPersonId], references: [id])
  enrollments   CourseEnrollment[]
  sessions      CourseSession[]

  @@index([courseId])
  @@index([organizationId, churchId])
  @@map("course_classes")
}

model CourseEnrollment {
  id                         String                  @id @default(cuid())
  classId                    String                  @map("class_id")
  personId                   String                  @map("person_id")
  status                     CourseEnrollmentStatus  @default(ENROLLED)
  enrolledAt                 DateTime                @default(now()) @map("enrolled_at")
  completedAt                DateTime?               @map("completed_at")
  /// Aprovação mínima para emissão de certificado (metadado; sem PDF nesta fatia).
  certificateApprovedByUserId String?                @map("certificate_approved_by_user_id")
  certificateIssuedAt        DateTime?               @map("certificate_issued_at")
  createdAt                  DateTime                @default(now()) @map("created_at")
  updatedAt                  DateTime                @updatedAt @map("updated_at")

  class               CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  person              Person      @relation(fields: [personId], references: [id])
  certificateApprover User?       @relation("CourseCompletionApprover", fields: [certificateApprovedByUserId], references: [id])

  @@unique([classId, personId])
  @@index([personId])
  @@index([status])
  @@map("course_enrollments")
}

model CourseSession {
  id         String   @id @default(cuid())
  classId    String   @map("class_id")
  title      String?
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  class       CourseClass         @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances CourseAttendance[]

  @@index([classId, occurredAt])
  @@map("course_sessions")
}

model CourseAttendance {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  personId  String   @map("person_id")
  present   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person  Person        @relation(fields: [personId], references: [id])

  @@unique([sessionId, personId])
  @@index([personId])
  @@map("course_attendances")
}

enum ChurchAssetStatus {
  ACTIVE
  MAINTENANCE
  LOST
  DISPOSED
}

enum ChurchAssetHistoryKind {
  CREATED
  UPDATED
  STATUS_CHANGE
  LOCATION_CHANGE
  RESPONSIBLE_CHANGE
  NOTE
}

/// Patrimônio mínimo (RF-030 fatia F6) — registro por congregação.
model ChurchAsset {
  id                   String            @id @default(cuid())
  organizationId       String            @map("organization_id")
  churchId             String            @map("church_id")
  code                 String?
  name                 String
  description          String?
  location             String?
  responsiblePersonId  String?           @map("responsible_person_id")
  status               ChurchAssetStatus @default(ACTIVE)
  acquiredAt           DateTime?         @map("acquired_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id])
  church       Church               @relation(fields: [churchId], references: [id])
  responsible  Person?              @relation("ChurchAssetResponsible", fields: [responsiblePersonId], references: [id])
  history      ChurchAssetHistory[]

  @@unique([churchId, code])
  @@index([organizationId, churchId])
  @@index([status])
  @@index([responsiblePersonId])
  @@map("church_assets")
}

model ChurchAssetHistory {
  id                       String                 @id @default(cuid())
  assetId                  String                 @map("asset_id")
  kind                     ChurchAssetHistoryKind
  note                     String?
  fromStatus               ChurchAssetStatus?     @map("from_status")
  toStatus                 ChurchAssetStatus?     @map("to_status")
  fromLocation             String?                @map("from_location")
  toLocation               String?                @map("to_location")
  fromResponsiblePersonId  String?                @map("from_responsible_person_id")
  toResponsiblePersonId    String?                @map("to_responsible_person_id")
  actorUserId              String?                @map("actor_user_id")
  recordedAt               DateTime               @default(now()) @map("recorded_at")
  createdAt                DateTime               @default(now()) @map("created_at")

  asset ChurchAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actor User?       @relation("ChurchAssetHistoryActor", fields: [actorUserId], references: [id])

  @@index([assetId, recordedAt])
  @@map("church_asset_history")
}

/// Device token FCM para app membro (RF-025). Persistência + outbox mock/noop — sem FCM live.
model PushDeviceToken {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  churchId       String       @map("church_id")
  personId       String       @map("person_id")
  /// Token opaco do provedor (FCM). Não logar em claro com dados reais.
  token          String
  platform       PushPlatform
  /// Sempre FCM neste contrato (APNs live fora de escopo).
  provider       String       @default("FCM")
  deviceLabel    String?      @map("device_label")
  appId          String?      @map("app_id")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])

  @@unique([churchId, token])
  @@index([personId, churchId, revokedAt])
  @@index([organizationId, churchId])
  @@map("push_device_tokens")
}
