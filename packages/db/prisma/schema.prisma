  id                     String            @id @default(cuid())
  organizationId         String            @map("organization_id")
  churchId               String            @map("church_id")
  entryDate              DateTime          @map("entry_date") @db.Date
  description            String
  status                 LedgerEntryStatus @default(DRAFT)
  /// Soma dos débitos (deve igualar créditos) — centavos BRL sintéticos.
  amountCents            Int               @map("amount_cents")
  createdByUserId        String            @map("created_by_user_id")
  submittedAt            DateTime?         @map("submitted_at")
  firstApprovedByUserId  String?           @map("first_approved_by_user_id")
  firstApprovedAt        DateTime?         @map("first_approved_at")
  secondApprovedByUserId String?           @map("second_approved_by_user_id")
  secondApprovedAt       DateTime?         @map("second_approved_at")
  rejectedByUserId       String?           @map("rejected_by_user_id")
  rejectedAt             DateTime?         @map("rejected_at")
  rejectionReason        String?           @map("rejection_reason")
  reversalOfEntryId      String?           @unique @map("reversal_of_entry_id")
  importBatchId          String?           @map("import_batch_id")
  reconciliationId       String?           @map("reconciliation_id")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id])
  church        Church           @relation(fields: [churchId], references: [id])
  createdBy     User             @relation("LedgerEntryCreator", fields: [createdByUserId], references: [id])
  firstApprover User?            @relation("LedgerEntryFirstApprover", fields: [firstApprovedByUserId], references: [id])
  secondApprover User?           @relation("LedgerEntrySecondApprover", fields: [secondApprovedByUserId], references: [id])
  reversalOf    LedgerEntry?     @relation("LedgerEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversedBy    LedgerEntry?     @relation("LedgerEntryReversal")
  importBatch   BankImportBatch? @relation(fields: [importBatchId], references: [id])
  reconciliation Reconciliation? @relation(fields: [reconciliationId], references: [id])
  lines         LedgerEntryLine[]
  matchedBankLines BankStatementLine[]

  @@index([organizationId, churchId, status])
  @@index([churchId, entryDate])
  @@index([importBatchId])
  @@index([reconciliationId])
  @@map("ledger_entries")
}

model LedgerEntryLine {
  id          String         @id @default(cuid())
