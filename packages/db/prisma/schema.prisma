  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  leader       Person?      @relation("MinistryLeader", fields: [leaderPersonId], references: [id])
  rosters      Roster[]
  grants       Grant[]
  portalEvents PortalEvent[]
  cmsContents  CmsContent[]
  volunteerInterests VolunteerInterest[]

  @@unique([churchId, slug])
  @@index([organizationId, churchId])
  @@index([churchId, publishStatus, visibility])
  ministryMemberships MinistryMembership[]
  @@map("ministries")
}

 
/// Vínculo formal de integrantes; não confundir com manifestação de interesse.
model MinistryMembership {
  id                  String    @id @default(cuid())
  organizationId      String    @map("organization_id")
  churchId            String    @map("church_id")
  ministryId          String    @map("ministry_id")
  personId            String    @map("person_id")
  role                String
  status              String    @default("ATIVO")
  source              String    @default("DIRETO")
  volunteerInterestId String?   @map("volunteer_interest_id")
  startedAt           DateTime  @default(now()) @map("started_at")
  endedAt             DateTime? @map("ended_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id])
  church       Church             @relation(fields: [churchId], references: [id])
  ministry     Ministry           @relation(fields: [ministryId], references: [id])
  person       Person             @relation(fields: [personId], references: [id])
  interest     VolunteerInterest? @relation(fields: [volunteerInterestId], references: [id])

  @@unique([ministryId, personId])
  @@index([organizationId, churchId, ministryId])
  @@index([personId])
  @@map("ministry_memberships")
}


/// Eventos do portal + fatia inscrição RF-020/021 (modalidades/lotes/check-in/pagamento mock).
/// RF-022 hospedagem/alimentação/transporte permanece fora desta fatia.
model PortalEvent {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  churchId       String            @map("church_id")
  ministryId     String?           @map("ministry_id")
  name           String
  slug           String
  description    String?
  imageUrl       String?           @map("image_url")
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime?         @map("ends_at")
  locationText   String?           @map("location_text")
  status         PortalEventStatus @default(DRAFT)
  featuredOnHome Boolean           @default(false) @map("featured_on_home")
  publishedAt    DateTime?         @map("published_at")
  cancelledAt    DateTime?         @map("cancelled_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  ministry     Ministry?    @relation(fields: [ministryId], references: [id])
  modalities   EventModality[]
  lots         EventLot[]
  registrations EventRegistration[]
  paymentIntents EventPaymentIntent[]
  lodgingOptions   EventLodgingOption[]
  mealOptions      EventMealOption[]
  transportOptions EventTransportOption[]

  @@unique([churchId, slug])
  @@index([organizationId, churchId])
  @@index([churchId, status, startsAt])
  @@index([ministryId])
  @@index([featuredOnHome, status])
  @@map("portal_events")
}

enum EventModalityKind {
  INDIVIDUAL
  COUPLE
  FAMILY
  CUSTOM
}

enum EventLotStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EventRegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CANCELLED
}

/// Pagamento simulado ou crédito conferido na conta da igreja. Sem gateway live.
enum EventPaymentStatus {
  PENDING
  CONFIRMED_MOCK
  FAILED_MOCK
  CANCELLED
  /// Tesouraria conferiu o crédito na conta escolhida. Não passa por Mercado Pago.
  CONFIRMED_PIX
}

/// Modalidade / trilha do evento (capacidade própria opcional).
model EventModality {
  id             String            @id @default(cuid())
  eventId        String            @map("event_id")
  code           String
  name           String
  kind           EventModalityKind @default(INDIVIDUAL)
  capacity       Int?
  minPartySize   Int               @default(1) @map("min_party_size")
  maxPartySize   Int               @default(1) @map("max_party_size")
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  event          PortalEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lots           EventLot[]
  registrations  EventRegistration[]

  @@unique([eventId, code])
  @@index([eventId, sortOrder])
  @@map("event_modalities")
}

/// Lote de inscrição (janela + preço mock + capacidade).
model EventLot {
  id             String         @id @default(cuid())
  eventId        String         @map("event_id")
  modalityId     String?        @map("modality_id")
  code           String
  name           String
  capacity       Int?
  priceCents     Int            @default(0) @map("price_cents")
  currency       String         @default("BRL")
  opensAt        DateTime?      @map("opens_at")
  closesAt       DateTime?      @map("closes_at")
  status         EventLotStatus @default(DRAFT)
  /// Conta ativa da igreja que recebe o Pix quando o lote é pago.
  receivingAccountId String?    @map("receiving_account_id")
  sortOrder      Int            @default(0) @map("sort_order")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  event          PortalEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  modality       EventModality? @relation(fields: [modalityId], references: [id], onDelete: SetNull)
  receivingAccount ChurchReceivingAccount? @relation(fields: [receivingAccountId], references: [id])
  registrations  EventRegistration[]
  paymentIntents EventPaymentIntent[]

  @@unique([eventId, code])
  @@index([eventId, status, sortOrder])
  @@index([modalityId])
  @@map("event_lots")
}

enum EventLodgingKind {
  NONE
  SHARED
  COUPLE
  FAMILY
  CUSTOM
}

enum EventMealKind {
  NONE
  BREAKFAST
  LUNCH
  DINNER
  FULL_BOARD
  CUSTOM
}

enum EventTransportKind {
  NONE
  OWN
  EVENT_BUS
  CARPOOL
  CUSTOM
}

/// Status da autorização formal do responsável (RF-022) — só relevante para menores.
enum EventGuardianAuthStatus {
  NOT_REQUIRED
  PENDING
  AUTHORIZED
  REVOKED
}

/// Opção de hospedagem/alojamento do evento (capacidade própria opcional).
model EventLodgingOption {
  id        String           @id @default(cuid())
  eventId   String           @map("event_id")
  code      String
  name      String
  kind      EventLodgingKind @default(CUSTOM)
  capacity  Int?
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  event          PortalEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  EventRegistration[]

  @@unique([eventId, code])
  @@index([eventId, sortOrder])
  @@map("event_lodging_options")
}

/// Opção de alimentação do evento.
model EventMealOption {
  id        String        @id @default(cuid())
  eventId   String        @map("event_id")
  code      String
  name      String
  kind      EventMealKind @default(CUSTOM)
  capacity  Int?
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  event          PortalEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  EventRegistration[]

  @@unique([eventId, code])
  @@index([eventId, sortOrder])
  @@map("event_meal_options")
}

/// Opção de transporte do evento.
model EventTransportOption {
  id        String             @id @default(cuid())
  eventId   String             @map("event_id")
  code      String
  name      String
  kind      EventTransportKind @default(CUSTOM)
  capacity  Int?
  sortOrder Int                @default(0) @map("sort_order")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  event          PortalEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  EventRegistration[]

  @@unique([eventId, code])
  @@index([eventId, sortOrder])
  @@map("event_transport_options")
}

/// Inscrição — rótulos sintéticos apenas (sem CPF/e-mail/telefone reais nesta fatia).
model EventRegistration {
  id                   String                   @id @default(cuid())
  organizationId       String                   @map("organization_id")
  churchId             String                   @map("church_id")
  registrantPersonId   String?                  @map("registrant_person_id")
  eventId              String                   @map("event_id")
  modalityId           String                   @map("modality_id")
  lotId                String?                  @map("lot_id")
  lodgingOptionId      String?                  @map("lodging_option_id")
  mealOptionId         String?                  @map("meal_option_id")
  transportOptionId    String?                  @map("transport_option_id")
  displayName          String                   @map("display_name")
  /// Caixa fictícia do aviso de check-in. Fora das respostas públicas.
  notificationEmail    String?                  @map("notification_email")
  partySize            Int                      @default(1) @map("party_size")
  isMinor              Boolean                  @default(false) @map("is_minor")
  guardianDisplayName  String?                  @map("guardian_display_name")
  /// Autorização formal do responsável vinculada à participação (RF-022).
  guardianAuthStatus   EventGuardianAuthStatus  @default(NOT_REQUIRED) @map("guardian_auth_status")
  guardianAuthorizedAt DateTime?                @map("guardian_authorized_at")
  status               EventRegistrationStatus  @default(PENDING_PAYMENT)
  paymentStatus        EventPaymentStatus       @default(PENDING) @map("payment_status")
  /// Código opaco para check-in / consulta pública — não é PII.
  checkInCode          String                   @unique @map("check_in_code")
  checkedInAt          DateTime?                @map("checked_in_at")
  cancelledAt          DateTime?                @map("cancelled_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  registrant   Person?      @relation(fields: [registrantPersonId], references: [id], onDelete: SetNull)
  event        PortalEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  modality     EventModality @relation(fields: [modalityId], references: [id])
  lot          EventLot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)
  lodgingOption   EventLodgingOption?   @relation(fields: [lodgingOptionId], references: [id], onDelete: SetNull)
  mealOption      EventMealOption?      @relation(fields: [mealOptionId], references: [id], onDelete: SetNull)
  transportOption EventTransportOption? @relation(fields: [transportOptionId], references: [id], onDelete: SetNull)
  paymentIntents EventPaymentIntent[]
  guardianAuthorization EventGuardianAuthorization?

  @@index([organizationId, churchId])
  @@index([eventId, status])
  @@index([registrantPersonId, churchId])
  @@index([modalityId])
  @@index([lotId])
  @@index([lodgingOptionId])
  @@index([mealOptionId])
  @@index([transportOptionId])
  @@map("event_registrations")
}

/// Autorização formal de responsável para menor em evento (rótulo sintético; sem PII real).
model EventGuardianAuthorization {
  id                   String                  @id @default(cuid())
  organizationId       String                  @map("organization_id")
  churchId             String                  @map("church_id")
  registrationId       String                  @unique @map("registration_id")
  guardianDisplayName  String                  @map("guardian_display_name")
  status               EventGuardianAuthStatus @default(PENDING)
  /// Texto sintético de ciência — não é documento legal digitalizado.
  acknowledgmentText   String                  @map("acknowledgment_text")
  authorizedAt         DateTime?               @map("authorized_at")
  authorizedByUserId   String?                 @map("authorized_by_user_id")
  revokedAt            DateTime?               @map("revoked_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  church       Church            @relation(fields: [churchId], references: [id])
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([organizationId, churchId])
  @@index([status])
  @@map("event_guardian_authorizations")
}

model EventPaymentIntent {
  id               String             @id @default(cuid())
  organizationId   String             @map("organization_id")
  churchId         String             @map("church_id")
  eventId          String             @map("event_id")
  registrationId   String             @map("registration_id")
  lotId            String?            @map("lot_id")
  amountCents      Int                @map("amount_cents")
  currency         String             @default("BRL")
  status           EventPaymentStatus @default(PENDING)
  /// Referência sintética do provedor mock — nunca gateway live.
  providerRef      String?            @map("provider_ref")
  receivingAccountId String?          @map("receiving_account_id")
  ledgerEntryId    String?            @unique @map("ledger_entry_id")
  pixTxid          String?            @map("pix_txid")
  pixCopiaECola    String?            @map("pix_copia_e_cola")
  confirmedAt      DateTime?          @map("confirmed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  church       Church            @relation(fields: [churchId], references: [id])
  event        PortalEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  lot          EventLot?         @relation(fields: [lotId], references: [id], onDelete: SetNull)
  receivingAccount ChurchReceivingAccount? @relation(fields: [receivingAccountId], references: [id])
  ledgerEntry  LedgerEntry?      @relation(fields: [ledgerEntryId], references: [id])
  webhookReceipts EventPaymentWebhookReceipt[]

  @@index([organizationId, churchId])
  @@index([registrationId])
  @@index([eventId, status])
  @@map("event_payment_intents")
}

/// Inbox de webhook mock — chave de idempotência única + payload assinado.
model EventPaymentWebhookReceipt {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  churchId         String   @map("church_id")
  paymentIntentId  String   @map("payment_intent_id")
  idempotencyKey   String   @unique @map("idempotency_key")
  eventType        String   @map("event_type")
  payloadHash      String   @map("payload_hash")
  resultStatus     String   @map("result_status")
  createdAt        DateTime @default(now()) @map("created_at")

  organization  Organization      @relation(fields: [organizationId], references: [id])
  church        Church            @relation(fields: [churchId], references: [id])
  paymentIntent EventPaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId])
  @@map("event_payment_webhook_receipts")
}

/// Workflow editorial CMS (Frente D) — API pública só PUBLICADO.
enum CmsContentKind {
  HOME_BLOCK
  PAGE
  NEWS
  BANNER
  MINISTRY_CONTENT
}

enum CmsWorkflowStatus {
  RASCUNHO
  REVISAO
  APROVADO
  PUBLICADO
  ARQUIVADO
}

model CmsContent {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  churchId       String           @map("church_id")
  ministryId     String?          @map("ministry_id")
  kind           CmsContentKind
  slug           String
  title          String
  summary        String?
  body           String?
  imageUrl       String?          @map("image_url")
  sortOrder      Int              @default(0) @map("sort_order")
  status         CmsWorkflowStatus @default(RASCUNHO)
  publishedAt    DateTime?        @map("published_at")
  createdByUserId String?         @map("created_by_user_id")
  updatedByUserId String?         @map("updated_by_user_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  ministry     Ministry?    @relation(fields: [ministryId], references: [id])
