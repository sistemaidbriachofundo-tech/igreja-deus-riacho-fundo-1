// F1 IAM + F2 slice: membresia / secretaria / carteirinha (piloto single-church).
// Dados reais só após backup/restore comprovados. Seed = fictício.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  PENDING_ADMISSION
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum AdmissionStatus {
  DRAFT
  AWAITING_DOCUMENTS
  AWAITING_SECRETARIA
  AWAITING_PASTOR
  APPROVED
  REJECTED
  CANCELLED
}

enum AdmissionModality {
  BATISMO
  TRANSFERENCIA
  RECONCILIACAO
  OUTRO
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  churches    Church[]
  persons     Person[]
  households  Household[]
  memberships ChurchMembership[]
  credentials MemberCredential[]
  admissions  Admission[]
  grants      Grant[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Church {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  slug           String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id])
  homePersons  Person[]           @relation("PersonHomeChurch")
  households   Household[]
  memberships  ChurchMembership[]
  credentials  MemberCredential[]
  admissions   Admission[]
  grants       Grant[]
  auditLogs    AuditLog[]

  @@unique([organizationId, slug])
  @@map("churches")
}

/// Família leve (F2 slice) — vínculo opcional; regras de menores ficam para depois.
model Household {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  churchId       String   @map("church_id")
  label          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  persons      Person[]

  @@index([organizationId, churchId])
  @@map("households")
}

/// Pessoa única do domínio. A PK `id` é o `person_id` estável (DAS).
model Person {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  homeChurchId   String?      @map("home_church_id")
  householdId    String?      @map("household_id")
  displayName    String       @map("display_name")
  email          String?
  status         PersonStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id])
  homeChurch   Church?            @relation("PersonHomeChurch", fields: [homeChurchId], references: [id])
  household    Household?         @relation(fields: [householdId], references: [id])
  user         User?
  memberships  ChurchMembership[]
  credentials  MemberCredential[]
  admissions   Admission[]

  @@index([organizationId])
  @@index([homeChurchId])
  @@index([householdId])
  @@map("persons")
}

/// Conta de autenticação. Sempre ligada a um Person (`person_id`).
model User {
  id           String     @id @default(cuid())
  personId     String     @unique @map("person_id")
  email        String     @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  person           Person             @relation(fields: [personId], references: [id])
  grants           Grant[]
  auditLogs        AuditLog[]
  issuedCredentials MemberCredential[] @relation("CredentialIssuer")
  admissionsDocumentsCompleted Admission[] @relation("AdmissionDocumentsBy")
  admissionsSecretariaDecided  Admission[] @relation("AdmissionSecretariaBy")
  admissionsPastorDecided      Admission[] @relation("AdmissionPastorBy")

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  grants Grant[]

  @@map("roles")
}

/// Concessão RBAC com escopo opcional (ABAC mínimo: org / igreja).
model Grant {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  organizationId String?  @map("organization_id")
  churchId       String?  @map("church_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  church       Church?       @relation(fields: [churchId], references: [id])

  @@unique([userId, roleId, organizationId, churchId])
  @@index([userId])
  @@index([organizationId, churchId])
  @@map("grants")
}

/// Vínculo pessoa ↔ congregação (cadastro / secretaria). Piloto: só Riacho Fundo I.
model ChurchMembership {
  id             String           @id @default(cuid())
  personId       String           @map("person_id")
  churchId       String           @map("church_id")
  organizationId String           @map("organization_id")
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  leftAt         DateTime?        @map("left_at")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  person       Person             @relation(fields: [personId], references: [id])
  church       Church             @relation(fields: [churchId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  credentials  MemberCredential[]
  admissions   Admission[]

  @@unique([personId, churchId])
  @@index([churchId, status])
  @@index([organizationId, churchId])
  @@map("church_memberships")
}

/// Carteirinha digital: QR = token opaco (sem CPF/telefone/PII).
model MemberCredential {
  id             String           @id @default(cuid())
  membershipId   String           @map("membership_id")
  personId       String           @map("person_id")
  churchId       String           @map("church_id")
  organizationId String           @map("organization_id")
  status         CredentialStatus @default(ACTIVE)
  /// Token opaco base64url — único conteúdo do QR.
  opaqueToken    String           @unique @map("opaque_token")
  issuedAt       DateTime         @default(now()) @map("issued_at")
  revokedAt      DateTime?        @map("revoked_at")
  issuedByUserId String?          @map("issued_by_user_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  membership   ChurchMembership @relation(fields: [membershipId], references: [id])
  person       Person           @relation(fields: [personId], references: [id])
  church       Church           @relation(fields: [churchId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  issuedBy     User?            @relation("CredentialIssuer", fields: [issuedByUserId], references: [id])

  @@index([personId, status])
  @@index([churchId, status])
  @@index([membershipId, status])
  @@map("member_credentials")
}

/// Protocolo de admissão (M1). Carteirinha só após APPROVED + membresia ACTIVE.
model Admission {
  id             String              @id @default(cuid())
  personId       String              @map("person_id")
  membershipId   String?             @map("membership_id")
  churchId       String              @map("church_id")
  organizationId String              @map("organization_id")
  status         AdmissionStatus     @default(DRAFT)
  modality       AdmissionModality?
  notes          String?
  rejectionReason String?            @map("rejection_reason")

  modalityRecordedAt         DateTime? @map("modality_recorded_at")
  documentsCompletedAt       DateTime? @map("documents_completed_at")
  documentsCompletedByUserId String?   @map("documents_completed_by_user_id")
  secretariaDecidedAt        DateTime? @map("secretaria_decided_at")
  secretariaDecidedByUserId  String?   @map("secretaria_decided_by_user_id")
  pastorDecidedAt            DateTime? @map("pastor_decided_at")
  pastorDecidedByUserId      String?   @map("pastor_decided_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  person                 Person            @relation(fields: [personId], references: [id])
  membership             ChurchMembership? @relation(fields: [membershipId], references: [id])
  church                 Church            @relation(fields: [churchId], references: [id])
  organization           Organization      @relation(fields: [organizationId], references: [id])
  documentsCompletedBy   User?             @relation("AdmissionDocumentsBy", fields: [documentsCompletedByUserId], references: [id])
  secretariaDecidedBy    User?             @relation("AdmissionSecretariaBy", fields: [secretariaDecidedByUserId], references: [id])
  pastorDecidedBy        User?             @relation("AdmissionPastorBy", fields: [pastorDecidedByUserId], references: [id])

  @@index([churchId, status])
  @@index([organizationId, churchId])
  @@index([personId])
  @@index([membershipId])
  @@map("admissions")
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?  @map("actor_user_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  organizationId String?  @map("organization_id")
  churchId       String?  @map("church_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actorUser    User?         @relation(fields: [actorUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  church       Church?       @relation(fields: [churchId], references: [id])

  @@index([createdAt])
  @@index([organizationId, churchId])
  @@map("audit_logs")
}
