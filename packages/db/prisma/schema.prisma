  toStatus    CmsWorkflowStatus @map("to_status")
  actorUserId String?           @map("actor_user_id")
  note        String?
  /// Snapshot mínimo dos campos editoriais no momento da mudança.
  snapshot    Json
  createdAt   DateTime          @default(now()) @map("created_at")

