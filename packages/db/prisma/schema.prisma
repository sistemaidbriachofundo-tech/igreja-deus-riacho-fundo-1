// F1 IAM + F2: membresia / admissão / carteirinha (piloto single-church).
// Dados reais só após backup/restore comprovados. Seed = fictício.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

/// Visitante vs membro eclesiástico (cadastro único).
enum PersonKind {
  VISITOR
  MEMBER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  PENDING_ADMISSION
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum AdmissionStatus {
  DRAFT
  AWAITING_DOCUMENTS
  AWAITING_SECRETARIA
  AWAITING_PASTOR
  APPROVED
  REJECTED
  CANCELLED
}

enum AdmissionModality {
  BATISMO
  TRANSFERENCIA
  RECONCILIACAO
  OUTRO
}

enum AdmissionStep {
  modality
  documents
  secretaria
  pastor
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  churches       Church[]
  persons        Person[]
  households     Household[]
  memberships    ChurchMembership[]
  credentials    MemberCredential[]
  admissions     AdmissionProtocol[]
  grants         Grant[]
  auditLogs      AuditLog[]
  transfers      MembershipTransfer[]
  churchLetters  ChurchLetter[]
  pastoralCases  PastoralCase[]
  ministries     Ministry[]
  smallGroups    SmallGroup[]
  discipleshipTracks DiscipleshipTrack[]
  rosters        Roster[]
  portalEvents   PortalEvent[]
  cmsContents    CmsContent[]
  volunteerInterests VolunteerInterest[]
  oidcProviders  OidcProviderConfig[]

  @@map("organizations")
}

model Church {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  homePersons  Person[]            @relation("PersonHomeChurch")
  households   Household[]
  memberships  ChurchMembership[]
  credentials  MemberCredential[]
  admissions   AdmissionProtocol[]
  grants       Grant[]
  auditLogs    AuditLog[]
  transfersFrom MembershipTransfer[] @relation("TransferFromChurch")
  transfersTo   MembershipTransfer[] @relation("TransferToChurch")
  churchLetters ChurchLetter[]
  pastoralCases PastoralCase[]
  ministries    Ministry[]
  smallGroups   SmallGroup[]
  discipleshipTracks DiscipleshipTrack[]
  rosters       Roster[]
  portalEvents  PortalEvent[]
  cmsContents   CmsContent[]
  volunteerInterests VolunteerInterest[]

  @@unique([organizationId, slug])
  @@map("churches")
}

/// Família — vínculo opcional; menores exigem responsável legal (person).
model Household {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  churchId       String   @map("church_id")
  label          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  persons      Person[]

  @@index([organizationId, churchId])
  @@map("households")
}

/// Pessoa única do domínio. A PK `id` é o `person_id` estável (DAS).
model Person {
  id                   String       @id @default(cuid())
  organizationId       String       @map("organization_id")
  homeChurchId         String?      @map("home_church_id")
  householdId          String?      @map("household_id")
  displayName          String       @map("display_name")
  email                String?
  status               PersonStatus @default(ACTIVE)
  kind                 PersonKind   @default(VISITOR)
  isMinor              Boolean      @default(false) @map("is_minor")
  legalGuardianPersonId String?     @map("legal_guardian_person_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id])
  homeChurch    Church?             @relation("PersonHomeChurch", fields: [homeChurchId], references: [id])
  household     Household?          @relation(fields: [householdId], references: [id])
  legalGuardian Person?             @relation("PersonGuardian", fields: [legalGuardianPersonId], references: [id])
  dependents    Person[]            @relation("PersonGuardian")
  user          User?
  memberships   ChurchMembership[]
  credentials   MemberCredential[]
  admissions    AdmissionProtocol[]
  transfers     MembershipTransfer[]
  churchLetters ChurchLetter[]
  pastoralCases PastoralCase[]
  ministryLeads Ministry[] @relation("MinistryLeader")
  smallGroupLeads SmallGroup[] @relation("SmallGroupLeader")
  smallGroupMemberships SmallGroupMember[]
  discipleshipEnrollments DiscipleshipEnrollment[]
  discipleshipMentorships DiscipleshipEnrollment[] @relation("DiscipleshipMentor")
  rosterAssignments RosterAssignment[] @relation("RosterAssignee")
  rosterPartnerships RosterAssignment[] @relation("RosterPartner")
  volunteerInterests VolunteerInterest[]

  @@index([organizationId])
  @@index([homeChurchId])
  @@index([householdId])
  @@index([organizationId, displayName])
  @@index([legalGuardianPersonId])
  @@map("persons")
}

model User {
  id           String     @id @default(cuid())
  personId     String     @unique @map("person_id")
  email        String     @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  /// Quando true, login local exige segundo fator (TOTP) se habilitado.
  mfaRequired  Boolean    @default(false) @map("mfa_required")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  person            Person             @relation(fields: [personId], references: [id])
  grants            Grant[]
  auditLogs         AuditLog[]
  issuedCredentials MemberCredential[] @relation("CredentialIssuer")
  transfersRequested MembershipTransfer[] @relation("TransferRequester")
  lettersIssued     ChurchLetter[]     @relation("LetterIssuer")
  pastoralCreated   PastoralCase[]     @relation("PastoralCreator")
  pastoralAssigned  PastoralCase[]     @relation("PastoralAssignee")
  mfaFactors        UserMfaFactor[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  grants Grant[]

  @@map("roles")
}

model Grant {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  organizationId String?  @map("organization_id")
  churchId       String?  @map("church_id")
  /// Escopo opcional de ministério (LIDER_MINISTERIO só opera o próprio).
  ministryId     String?  @map("ministry_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  church       Church?       @relation(fields: [churchId], references: [id])
  ministry     Ministry?     @relation(fields: [ministryId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, organizationId, churchId, ministryId])
  @@index([userId])
  @@index([organizationId, churchId])
  @@index([ministryId])
  @@map("grants")
}

model ChurchMembership {
  id             String           @id @default(cuid())
  personId       String           @map("person_id")
  churchId       String           @map("church_id")
  organizationId String           @map("organization_id")
  status         MembershipStatus @default(PENDING_ADMISSION)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  leftAt         DateTime?        @map("left_at")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  person      Person              @relation(fields: [personId], references: [id])
  church      Church              @relation(fields: [churchId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  credentials MemberCredential[]
  admissions  AdmissionProtocol[]

  @@unique([personId, churchId])
  @@index([churchId, status])
  @@index([organizationId, churchId])
  @@map("church_memberships")
}

/// Protocolo formal de admissão (DAS / Central de Membresia v5).
model AdmissionProtocol {
  id                   String            @id @default(cuid())
  personId             String            @map("person_id")
  membershipId         String?           @map("membership_id")
  organizationId       String            @map("organization_id")
  churchId             String            @map("church_id")
  status               AdmissionStatus   @default(DRAFT)
  modality             AdmissionModality?
  currentStep          AdmissionStep     @default(modality) @map("current_step")
  modalityRecorded     Boolean           @default(false) @map("modality_recorded")
  documentsComplete    Boolean           @default(false) @map("documents_complete")
  secretariaApproved   Boolean           @default(false) @map("secretaria_approved")
  pastorApproved       Boolean           @default(false) @map("pastor_approved")
  notes                String?
  rejectionReason      String?           @map("rejection_reason")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  person       Person            @relation(fields: [personId], references: [id])
  membership   ChurchMembership? @relation(fields: [membershipId], references: [id])
  organization Organization      @relation(fields: [organizationId], references: [id])
  church       Church            @relation(fields: [churchId], references: [id])
  documents    AdmissionDocument[]

  @@index([churchId, status])
  @@index([personId])
  @@index([organizationId, churchId])
  @@map("admission_protocols")
}

/// Metadados de documento de admissão — bytes em storage privado (não público).
model AdmissionDocument {
  id               String   @id @default(cuid())
  admissionId      String   @map("admission_id")
  organizationId   String   @map("organization_id")
  churchId         String   @map("church_id")
  uploadedByUserId String   @map("uploaded_by_user_id")
  /// Nome sanitizado para UI (sem path).
  displayName      String   @map("display_name")
  contentType      String   @map("content_type")
  byteSize         Int      @map("byte_size")
  /// Chave opaca no STORAGE_ROOT (nunca URL pública).
  storageKey       String   @unique @map("storage_key")
  createdAt        DateTime @default(now()) @map("created_at")

  admission AdmissionProtocol @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([organizationId, churchId])
  @@map("admission_documents")
}

model MemberCredential {
  id             String           @id @default(cuid())
  membershipId   String           @map("membership_id")
  personId       String           @map("person_id")
  churchId       String           @map("church_id")
  organizationId String           @map("organization_id")
  status         CredentialStatus @default(ACTIVE)
  opaqueToken    String           @unique @map("opaque_token")
  issuedAt       DateTime         @default(now()) @map("issued_at")
  revokedAt      DateTime?        @map("revoked_at")
  issuedByUserId String?          @map("issued_by_user_id")
  /// Chave opaca no STORAGE_ROOT do PDF da carteirinha (nunca URL pública).
  pdfStorageKey  String?          @unique @map("pdf_storage_key")
  pdfContentType String?          @map("pdf_content_type")
  pdfByteSize    Int?             @map("pdf_byte_size")
  pdfGeneratedAt DateTime?        @map("pdf_generated_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  membership   ChurchMembership @relation(fields: [membershipId], references: [id])
  person       Person           @relation(fields: [personId], references: [id])
  church       Church           @relation(fields: [churchId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  issuedBy     User?            @relation("CredentialIssuer", fields: [issuedByUserId], references: [id])

  @@index([personId, status])
  @@index([churchId, status])
  @@index([membershipId, status])
  @@map("member_credentials")
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?  @map("actor_user_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  organizationId String?  @map("organization_id")
  churchId       String?  @map("church_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actorUser    User?         @relation(fields: [actorUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  church       Church?       @relation(fields: [churchId], references: [id])

  @@index([createdAt])
  @@index([organizationId, churchId])
  @@map("audit_logs")
}

// —— F2 restante: transferência + cartas ——

enum TransferStatus {
  DRAFT
  AWAITING_ORIGIN
  AWAITING_DESTINATION
  COMPLETED
  CANCELLED
  REJECTED
}

enum ChurchLetterType {
  TRANSFERENCIA
  RECOMENDACAO
  MEMBRESIA
  OUTRO
}

enum ChurchLetterStatus {
  DRAFT
  ISSUED
  REVOKED
}

/// Transferência entre congregações — mesmo person_id (sem duplicar pessoa).
model MembershipTransfer {
  id                 String         @id @default(cuid())
  personId           String         @map("person_id")
  organizationId     String         @map("organization_id")
  fromChurchId       String         @map("from_church_id")
  toChurchId         String         @map("to_church_id")
  fromMembershipId   String         @map("from_membership_id")
  toMembershipId     String?        @map("to_membership_id")
  status             TransferStatus @default(DRAFT)
  notes              String?
  rejectionReason    String?        @map("rejection_reason")
  requestedByUserId  String         @map("requested_by_user_id")
  approvedOriginAt   DateTime?      @map("approved_origin_at")
  approvedDestAt     DateTime?      @map("approved_dest_at")
  completedAt        DateTime?      @map("completed_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  person      Person       @relation(fields: [personId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  fromChurch  Church       @relation("TransferFromChurch", fields: [fromChurchId], references: [id])
  toChurch    Church       @relation("TransferToChurch", fields: [toChurchId], references: [id])
  requestedBy User         @relation("TransferRequester", fields: [requestedByUserId], references: [id])

  @@index([personId, status])
  @@index([organizationId, fromChurchId])
  @@index([organizationId, toChurchId])
  @@map("membership_transfers")
}

/// Carta/certificado versionado (secretaria) — corpo texto; PDF opcional via STORAGE_ROOT.
model ChurchLetter {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  churchId       String             @map("church_id")
  personId       String             @map("person_id")
  letterType     ChurchLetterType   @map("letter_type")
  status         ChurchLetterStatus @default(DRAFT)
  title          String
  bodyText       String             @map("body_text")
  version        Int                @default(1)
  supersedesId   String?            @map("supersedes_id")
  issuedByUserId String?            @map("issued_by_user_id")
  issuedAt       DateTime?          @map("issued_at")
  revokedAt      DateTime?          @map("revoked_at")
  /// Metadado de PDF privado (opcional); nunca URL pública.
  storageKey     String?            @unique @map("storage_key")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])
  issuedBy     User?        @relation("LetterIssuer", fields: [issuedByUserId], references: [id])
  supersedes   ChurchLetter?  @relation("LetterVersions", fields: [supersedesId], references: [id])
  successors   ChurchLetter[] @relation("LetterVersions")

  @@index([churchId, letterType, status])
  @@index([personId])
  @@map("church_letters")
}

// —— F3: cuidado, discipulado, células, ministérios, escalas ——

enum PastoralCaseStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PastoralCaseKind {
  VISITA
  ORACAO
  ACOLHIMENTO
  ACOMPANHAMENTO
  OUTRO
}

/// Caso pastoral administrativo (sem prontuário clínico irrestrito).
model PastoralCase {
  id               String              @id @default(cuid())
  organizationId   String              @map("organization_id")
  churchId         String              @map("church_id")
  personId         String              @map("person_id")
  kind             PastoralCaseKind
  status           PastoralCaseStatus  @default(OPEN)
  title            String
  /// Resumo operacional — não substitui prontuário sensível.
  summary          String?
  assignedToUserId String?             @map("assigned_to_user_id")
  createdByUserId  String              @map("created_by_user_id")
  dueAt            DateTime?           @map("due_at")
  closedAt         DateTime?           @map("closed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  person       Person       @relation(fields: [personId], references: [id])
  assignedTo   User?        @relation("PastoralAssignee", fields: [assignedToUserId], references: [id])
  createdBy    User         @relation("PastoralCreator", fields: [createdByUserId], references: [id])
  tasks        PastoralTask[]

  @@index([churchId, status])
  @@index([personId])
  @@index([assignedToUserId])
  @@map("pastoral_cases")
}

model PastoralTask {
  id             String    @id @default(cuid())
  caseId         String    @map("case_id")
  title          String
  done           Boolean   @default(false)
  dueAt          DateTime? @map("due_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  case PastoralCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("pastoral_tasks")
}

model DiscipleshipTrack {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  churchId       String   @map("church_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  enrollments  DiscipleshipEnrollment[]

  @@index([organizationId, churchId])
  @@map("discipleship_tracks")
}

enum DiscipleshipEnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

model DiscipleshipEnrollment {
  id             String                       @id @default(cuid())
  trackId        String                       @map("track_id")
  personId       String                       @map("person_id")
  mentorPersonId String?                      @map("mentor_person_id")
  status         DiscipleshipEnrollmentStatus @default(ACTIVE)
  startedAt      DateTime                     @default(now()) @map("started_at")
  completedAt    DateTime?                    @map("completed_at")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  track   DiscipleshipTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  person  Person            @relation(fields: [personId], references: [id])
  mentor  Person?           @relation("DiscipleshipMentor", fields: [mentorPersonId], references: [id])

  @@unique([trackId, personId])
  @@index([personId])
  @@map("discipleship_enrollments")
}

enum MinistryVisibility {
  PUBLIC
  INTERNAL
}

enum MinistryPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PortalEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

model Ministry {
  id               String                @id @default(cuid())
  organizationId   String                @map("organization_id")
  churchId         String                @map("church_id")
  name             String
  slug             String
  leaderPersonId   String?               @map("leader_person_id")
  description      String?
  coverImageUrl    String?               @map("cover_image_url")
  galleryUrls      String[]              @default([]) @map("gallery_urls")
  scheduleText     String?               @map("schedule_text")
  /// JSON público: [{ "displayName": string, "roleTitle": string }] — sem telefone/docs.
  leadershipPublic Json?                 @map("leadership_public")
  participationInfo String?              @map("participation_info")
  visibility       MinistryVisibility    @default(INTERNAL)
  publishStatus    MinistryPublishStatus @default(DRAFT)
  publishedAt      DateTime?             @map("published_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  leader       Person?      @relation("MinistryLeader", fields: [leaderPersonId], references: [id])
  rosters      Roster[]
  grants       Grant[]
  portalEvents PortalEvent[]
  cmsContents  CmsContent[]
  volunteerInterests VolunteerInterest[]

  @@unique([churchId, slug])
  @@index([organizationId, churchId])
  @@index([churchId, publishStatus, visibility])
  @@map("ministries")
}

/// Núcleo de eventos do portal (F4 fatia pública) — sem inscrição/financeiro/check-in.
model PortalEvent {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  churchId       String            @map("church_id")
  ministryId     String?           @map("ministry_id")
  name           String
  slug           String
  description    String?
  imageUrl       String?           @map("image_url")
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime?         @map("ends_at")
  locationText   String?           @map("location_text")
  status         PortalEventStatus @default(DRAFT)
  featuredOnHome Boolean           @default(false) @map("featured_on_home")
  publishedAt    DateTime?         @map("published_at")
  cancelledAt    DateTime?         @map("cancelled_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  ministry     Ministry?    @relation(fields: [ministryId], references: [id])

  @@unique([churchId, slug])
  @@index([organizationId, churchId])
  @@index([churchId, status, startsAt])
  @@index([ministryId])
  @@index([featuredOnHome, status])
  @@map("portal_events")
}

/// Workflow editorial CMS (Frente D) — API pública só PUBLICADO.
enum CmsContentKind {
  HOME_BLOCK
  PAGE
  NEWS
  BANNER
  MINISTRY_CONTENT
}

enum CmsWorkflowStatus {
  RASCUNHO
  REVISAO
  APROVADO
  PUBLICADO
  ARQUIVADO
}

model CmsContent {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  churchId       String           @map("church_id")
  ministryId     String?          @map("ministry_id")
  kind           CmsContentKind
  slug           String
  title          String
  summary        String?
  body           String?
  imageUrl       String?          @map("image_url")
  sortOrder      Int              @default(0) @map("sort_order")
  status         CmsWorkflowStatus @default(RASCUNHO)
  publishedAt    DateTime?        @map("published_at")
  createdByUserId String?         @map("created_by_user_id")
  updatedByUserId String?         @map("updated_by_user_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  ministry     Ministry?    @relation(fields: [ministryId], references: [id])
  revisions    CmsContentRevision[]

  @@unique([churchId, slug])
  @@index([organizationId, churchId])
  @@index([churchId, status, kind])
  @@index([ministryId])
  @@map("cms_contents")
}

model CmsContentRevision {
  id          String            @id @default(cuid())
  contentId   String            @map("content_id")
  fromStatus  CmsWorkflowStatus @map("from_status")
  toStatus    CmsWorkflowStatus @map("to_status")
  actorUserId String?           @map("actor_user_id")
  note        String?
  /// Snapshot mínimo dos campos editoriais no momento da mudança.
  snapshot    Json
  createdAt   DateTime          @default(now()) @map("created_at")

  content CmsContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@map("cms_content_revisions")
}

/// Jornada Atmosfera (Frente E) — Interesse→…→Escala; PII só admin.
enum VolunteerJourneyStage {
  INTERESSE
  AVALIACAO
  APROVACAO
  EQUIPE
  DISPONIBILIDADE
  ESCALA
}

enum VolunteerInterestStatus {
  OPEN
  REJECTED
  CLOSED
}

model VolunteerInterest {
  id             String                   @id @default(cuid())
  organizationId String                   @map("organization_id")
  churchId       String                   @map("church_id")
  ministryId     String                   @map("ministry_id")
  /// Nome de preferência público — sem documentos.
  displayName    String                   @map("display_name")
  /// Contato só admin; nunca ecoado em API pública.
  email          String
  phone          String?
  message        String?
  personId       String?                  @map("person_id")
  stage          VolunteerJourneyStage    @default(INTERESSE)
  status         VolunteerInterestStatus  @default(OPEN)
  notesInternal  String?                  @map("notes_internal")
  rosterId       String?                  @map("roster_id")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  ministry     Ministry     @relation(fields: [ministryId], references: [id])
  person       Person?      @relation(fields: [personId], references: [id])

  @@index([organizationId, churchId])
  @@index([ministryId, stage, status])
  @@index([email])
  @@map("volunteer_interests")
}

model SmallGroup {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  churchId       String   @map("church_id")
  name           String
  leaderPersonId String?  @map("leader_person_id")
  meetsAtHint    String?  @map("meets_at_hint")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  leader       Person?      @relation("SmallGroupLeader", fields: [leaderPersonId], references: [id])
  members      SmallGroupMember[]
  meetings     GroupMeeting[]

  @@index([organizationId, churchId])
  @@map("small_groups")
}

enum SmallGroupMemberRole {
  LEADER
  MEMBER
}

model SmallGroupMember {
  id        String               @id @default(cuid())
  groupId   String               @map("group_id")
  personId  String               @map("person_id")
  role      SmallGroupMemberRole @default(MEMBER)
  joinedAt  DateTime             @default(now()) @map("joined_at")

  group  SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person Person     @relation(fields: [personId], references: [id])

  @@unique([groupId, personId])
  @@index([personId])
  @@map("small_group_members")
}

model GroupMeeting {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  occurredAt DateTime @map("occurred_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  group       SmallGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances GroupMeetingAttendance[]

  @@index([groupId, occurredAt])
  @@map("group_meetings")
}

model GroupMeetingAttendance {
  id        String  @id @default(cuid())
  meetingId String  @map("meeting_id")
  personId  String  @map("person_id")
  present   Boolean @default(true)

  meeting GroupMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, personId])
  @@index([personId])
  @@map("group_meeting_attendances")
}

enum RosterStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RosterAssignmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  SUBSTITUTED
}

model Roster {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  churchId       String       @map("church_id")
  ministryId     String?      @map("ministry_id")
  title          String
  serviceAt      DateTime     @map("service_at")
  status         RosterStatus @default(DRAFT)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  church       Church       @relation(fields: [churchId], references: [id])
  ministry     Ministry?    @relation(fields: [ministryId], references: [id])
  slots        RosterSlot[]

  @@index([churchId, serviceAt])
  @@index([ministryId])
  @@map("rosters")
}

model RosterSlot {
  id            String  @id @default(cuid())
  rosterId      String  @map("roster_id")
  roleLabel     String  @map("role_label")
  requiresCouple Boolean @default(false) @map("requires_couple")
  sortOrder     Int     @default(0) @map("sort_order")

  roster       Roster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  assignments  RosterAssignment[]

  @@index([rosterId])
  @@map("roster_slots")
}

model RosterAssignment {
  id                      String                 @id @default(cuid())
  slotId                  String                 @map("slot_id")
  personId                String                 @map("person_id")
  partnerPersonId         String?                @map("partner_person_id")
  status                  RosterAssignmentStatus @default(PENDING)
  substituteForId         String?                @map("substitute_for_id")
  confirmedAt             DateTime?              @map("confirmed_at")
  declinedAt              DateTime?              @map("declined_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  slot          RosterSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  person        Person     @relation("RosterAssignee", fields: [personId], references: [id])
  partner       Person?    @relation("RosterPartner", fields: [partnerPersonId], references: [id])
  substituteFor RosterAssignment?  @relation("RosterSubstitution", fields: [substituteForId], references: [id])
  substitutes   RosterAssignment[] @relation("RosterSubstitution")

  @@index([slotId, status])
  @@index([personId])
  @@map("roster_assignments")
}

// —— F1/F2 hooks: MFA (TOTP) + OIDC config (sem IdP live) ——

enum MfaFactorType {
  TOTP
}

enum MfaFactorStatus {
  DISABLED
  PENDING_ENROLLMENT
  ENABLED
}

enum OidcProviderStatus {
  DISABLED
  CONFIGURED
  ENABLED
}

/// Fator MFA por usuário — TOTP local; secret cifrado; sem IdP.
model UserMfaFactor {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  factorType       MfaFactorType   @default(TOTP) @map("factor_type")
  status           MfaFactorStatus @default(DISABLED)
  /// Segredo TOTP cifrado (AES-GCM); nunca expor em listagens.
  secretCiphertext String?         @map("secret_ciphertext")
  label            String?
  verifiedAt       DateTime?       @map("verified_at")
  disabledAt       DateTime?       @map("disabled_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, factorType])
  @@index([userId, status])
  @@map("user_mfa_factors")
}

/// Config OIDC por organização — placeholders; login federado NÃO live neste contrato.
model OidcProviderConfig {
  id              String             @id @default(cuid())
  organizationId  String             @map("organization_id")
  status          OidcProviderStatus @default(DISABLED)
  displayName     String?            @map("display_name")
  issuerUrl       String?            @map("issuer_url")
  clientId        String?            @map("client_id")
  /// Nome da env/secret store — nunca o secret em claro no banco.
  clientSecretRef String?            @map("client_secret_ref")
  redirectUri     String?            @map("redirect_uri")
  scopes          String             @default("openid profile email")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId])
  @@map("oidc_provider_configs")
}
